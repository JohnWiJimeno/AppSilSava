            <div class="kpi-sub" style="color:#00bcd4;">registradas</div>
        </div>
        <div class="kpi kg">
            <div class="kpi-icon">✅</div>
            <div class="kpi-lbl">Activas</div>
            <div class="kpi-val" style="color:#00c853;">10</div>
            <div class="kpi-sub" style="color:#00c853;">habilitadas</div>
        </div>
        <div class="kpi ka">
            <div class="kpi-icon">🌱</div>
            <div class="kpi-lbl">MiPymes</div>
            <div class="kpi-val" style="color:#ffab00;">10</div>
            <div class="kpi-sub" style="color: #ffab00;">registradas</div>
        </div>
        <div class="kpi kp">
            <div class="kpi-icon">♿</div>
            <div class="kpi-lbl">Discapacitados</div>
            <div class="kpi-val" style="color:#b388ff;">10</div>
            <div class="kpi-sub" style="color:#b388ff;">habilitados</div>
        </div>
        <div class="kpi kt">
            <div class="kpi-icon">👩‍💼</div>
            <div class="kpi-lbl">Emprend. mujer</div>
            <div class="kpi-val" style="color:#26c6da;">10</div>
            <div class="kpi-sub" style="color:#26c6da;">activos</div>
        </div>
        <div class="kpi kr">
            <div class="kpi-icon">❌</div>
            <div class="kpi-lbl">Inactivas</div>
