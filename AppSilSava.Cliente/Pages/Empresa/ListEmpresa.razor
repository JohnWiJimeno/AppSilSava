@page "/empresa"
@inject NavigationManager navigationManager
@inject IEmpresaProxy EmpresaProxy
@inject SweetAlertService Swal;

<div class="container">
    <CardInfo Titulo="Lista de Empresas">
        <Content>
            <div class="input-group mb-3">
                <span class="input-group-text" id="basic-addon3">Ingrese CC/NIT</span>
                <input type="text" class="form-control" id="basic-url" aria-describedby="basic-addon3" @bind="NombreCompleto">
            </div>

            <ButtonsHeader OnBuscar="()=>buscar()" OnLimpiar="()=>limpiar()" OnNuevo="()=>Nuevo()" />


            @* <div class="text-center>">
                <button class="btn btn-primary" @onclick="()=>buscar()">Buscar</button>
                <buttton class="btn btn-danger" @onclick="()=>limpiar()">Limpiar</buttton>
                <button class="btn btn-success" @onclick="()=>Nuevo()">Nuevo</button>

            </div> *@
        </Content>

    </CardInfo>
</div>
  <div class="mt-5">
    <CardInfo Titulo="Lista de Empresas">
        <Content>
            <table class="table">
                <thead>
                    <tr>
                        <th>Nit/CC</th>
                        <th>Razon Social</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var empresa in ListaEmpresas)
                    {
                        <tr>
                            <td>@empresa.EmpresaId</td>
                            <td>@empresa.RazonSocial</td>
                            <td>
                                <button class="btn btn-sm btn-primary" @onclick="() => Editar(empresa.EmpresaId)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pen" viewBox="0 0 16 16">
                                        <path d="m13.498.795.149-.149a1.207 1.207 0 1 1 1.707 1.708l-.149.148a1.5 1.5 0 0 1-.059 2.059L4.854 14.854a.5.5 0 0 1-.233.131l-4 1a.5.5 0 0 1-.606-.606l1-4a.5.5 0 0 1 .131-.232l9.642-9.642a.5.5 0 0 0-.642.056L6.854 4.854a.5.5 0 1 1-.708-.708L9.44.854A1.5 1.5 0 0 1 11.5.796a1.5 1.5 0 0 1 1.998-.001m-.644.766a.5.5 0 0 0-.707 0L1.95 11.756l-.764 3.057 3.057-.764L14.44 3.854a.5.5 0 0 0 0-.708z" />
                                    </svg>
                                </button>
                                <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(empresa.EmpresaId)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash3" viewBox="0 0 16 16">
                                        <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1zm1.958 1-.846 10.58a1 1 0 0 1-.997.92h-6.23a1 1 0 0 1-.997-.92L3.042 3.5zm-7.487 1a.5.5 0 0 1 .528.47l.5 8.5a.5.5 0 0 1-.998.06L5 5.03a.5.5 0 0 1 .47-.53Zm5.058 0a.5.5 0 0 1 .47.53l-.5 8.5a.5.5 0 1 1-.998-.06l.5-8.5a.5.5 0 0 1 .528-.47M8 4.5a.5.5 0 0 1 .5.5v8.5a.5.5 0 0 1-1 0V5a.5.5 0 0 1 .5-.5" />
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </Content>
    </CardInfo>
  </div>
    
@code {

    public List<EmpresaResponse> ListaEmpresas { get; set; } = new List<EmpresaResponse>();

    protected override async Task OnInitializedAsync()
    {
        //logica para cargar la lista de empresas
        var rpta = await EmpresaProxy.Listar();
        ListaEmpresas = rpta.Data;
    }

    private void Editar(string EmpresaId)
    {
       
        navigationManager.NavigateTo($"/empresa/editar/{EmpresaId}");//logica para editar empresa por id
    }

    private async Task Eliminar(string EmpresaId)
    {
        SweetAlertResult result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Desea eliminar la empresa "+EmpresaId+"?",
            Text = "¡No podrás recuperar los datos de esta empresa!",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "¡Sí, bórralo!",
            CancelButtonText = "No, consérvalo"
        });
        if (!string.IsNullOrEmpty(result.Value))
        {
            await Swal.FireAsync(
              "Eliminado",
              "La empresa ha sido eliminada:" + EmpresaId,
              SweetAlertIcon.Success
              );
        }

    }




    //captrar el nombre en la barra e busqueda y hacer la consulta a la base de datos
    public string NombreCompleto { get; set; } = default!;

    //pasa pagina para agregar empresa
    private void Nuevo()
    {
        navigationManager.NavigateTo("/empresa/add");
    }

    private void buscar()
    {
        //logica para buscar empresa por nombre completo
        Console.WriteLine($"nombre: {NombreCompleto}");
    }
    private void limpiar()
    {
        NombreCompleto = string.Empty;
    }

}
