            <div class="kpi-sub" style="color:#ef9a9a;">deshabilitadas</div>
        </div>
    </div>


    <!-- FILTROS -->
    <div class="emp-filters">
        <div class="fg">
            <label class="fl">🔍 Buscar</label>
            <input class="fi" type="text" placeholder="Razón social, NIT, ciudad…" @bind="NombreCompleto" @bind:event="oninput">
        </div>
        <div class="fg">
            <label class="fl">🏭 Tipo empresa</label>
            <select class="fs">
                <option value="">Todos los tipos</option>
                <option>SAS</option>
                <option>Ltda</option>
                <option>SA</option>
                <option>Persona Natural</option>
                <option>Consorcio</option>
                <option>Unión Temporal</option>
            </select>
        </div>
        <div class="fg">
            <label class="fl">📍 Departamento</label>
            <select class="fs">
                <option value="">Todos</option>
                <option>Atlántico</option>
                <option>Bolívar</option>
                <option>Cundinamarca</option>
                <option>Antioquia</option>
                <option>Valle del Cauca</option>
                <option>Santander</option>
            </select>
        </div>
        <div class="fg">
            <label class="fl">📌 Estado</label>
            <select class="fs">
                <option value="">Todos</option>
                <option value="true">Activa</option>
                <option value="false">Inactiva</option>
            </select>
        </div>
        <div class="fg">
            <label class="fl">🏷 Categoría especial</label>
            <select class="fs">
                <option value="">Todas</option>
                <option value="mipyme">MiPyme</option>
                <option value="disc">Discapacitado</option>
                <option value="mujer">Emprend. mujer</option>
            </select>
        </div>
        <button class="btn-clr">✕ Limpiar</button>
    </div>





    <div class="container">
        <CardInfo Titulo="Lista de Empresas">
            <Content>
                <div class="input-group mb-3">
                    <span class="input-group-text" id="basic-addon3">Ingrese Nit/CC</span>
                    @* <input type="text"
                                   class="form-control"
                                   id="basic-url"
                                   aria-describedby="basic-addon3"
                                   @bind="NombreCompleto"
                                   @bind:event="oninput"> *@
                </div>

                <ButtonsHeader OnBuscar="() => buscar()" OnLimpiar="() => limpiar()" OnNuevo="() => Nuevo()" />


                @* <div class="text-center>">
                <button class="btn btn-primary" @onclick="()=>buscar()">Buscar</button>
                <buttton class="btn btn-danger" @onclick="()=>limpiar()">Limpiar</buttton>
                <button class="btn btn-success" @onclick="()=>Nuevo()">Nuevo</button>

            </div> *@




            </Content>

        </CardInfo>
    </div>
    <div class="mt-5">
        <CardInfo Titulo="Lista de Empresas">
            <Content>
                <div clase="table-responsive w-100">
                    <table class="table table-sm tabla-contratos">
                        <thead>
                            <tr>
                                <th clase="col-id">Nit/CC</th>
                                <th clase="col-objeto">Razon Social</th>
                                <th clase="col-general">Departamento</th>
                                <th clase="col-general">Ciudad</th>
                                <th clase="col-general">Tamaño Empresa</th>
                                <th clase="col-general">Discapacitado</th>
                                <th clase="col-general">Emprendimiento Mujer</th>
                                <th clase="col-acciones">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var empresa in EmpresasPaginadas)
                            {
                                <tr>
                                    <td clase="col-id">@empresa.EmpresaId</td>
                                    <td clase="col-objeto">@empresa.RazonSocial</td>
                                    <td clase="col-general">@empresa.Departamento</td>
                                    <td clase="col-general">@empresa.Ciudad</td>
                                    <td clase="col-general">@empresa.TamanoEmpresa</td>
                                    <td clase="col-general">@(empresa.Discapacitado == true ? "Si" : "No")</td>
                                    <td>@(empresa.EmpredimientoMujer == true ? "Si" : "No")</td>
                                    <td>
                                        <ButtonsActions OnEditar="() => editar(empresa.EmpresaId)" OnEliminar="() => eliminar(empresa.EmpresaId)" OnVerDetalles="() => verDetalles(empresa.EmpresaId)" />

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <table class="table">
                    </table>
                </div>
                @* Invocas tu componente reutilizable así de limpio: *@
                <ComponentPaginacion PaginaActual="paginaActual" TotalPaginas="TotalPaginas" OnPaginaCambiada="CambiarPagina" />



            </Content>
        </CardInfo>
    </div>

    @*       </div>
    </div>
</div> *@

</div> @*el primer div*@

@*//modal*@
@if (MostrarModal && EmpresaSeleccionada != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">
                        <i class="oi oi-document me-2"></i> Información Completa de la Empresa
                    </h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body" style="max-height: 75vh; overflow-y: auto;">

                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <h6 class="text-primary border-bottom pb-1"><b>Información de la empresa</b></h6>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1"><b>Razon Social:</b> <span class="text-muted">@EmpresaSeleccionada.RazonSocial</span></p>
                            <p class="mb-1"><b>Sigla:</b> <span class="text-muted">@EmpresaSeleccionada.Sigla</span></p>
                            <p class="mb-1"><b>Matricula No.:</b> <span class="text-muted">@EmpresaSeleccionada.MatriculaNo</span></p>
                            <p class="mb-1"><b>Fecha Matricula:</b> <span class="text-muted">@EmpresaSeleccionada.FechaMatricula?.ToString("dd/MM/yyyy")</span></p>

                            
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1"><b>Dirección:</b> <span class="text-muted">@EmpresaSeleccionada.DireccionDomiclio</span></p>
                            <p class="mb-1"><b>Correo:</b> <span class="text-muted">@EmpresaSeleccionada.Correo</span></p>
                            <p class="mb-1"><b>Telefono:</b> <span class="text-muted">@((EmpresaSeleccionada.Telefono))</span></p>
                            <p class="mb-1"><b>Tipo Empresa:</b> <span class="text-muted">@EmpresaSeleccionada.NombreTipoEmpresa</span></p>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <h6 class="text-primary border-bottom pb-1"><b>Información Adicional de la empresa</b></h6>
                        </div>

                        <div class="col-md-6">
                            <p class="mb-2"><b>Nombre Rep. Legal:</b> <span class="text-muted">@(EmpresaSeleccionada.NombreRepLegal ?? "N/A")</span></p>
                            <p class="mb-2"><b>C.C Rep Legal:</b> <span class="text-muted">@(EmpresaSeleccionada.IdentificacionRl ?? "N/A")</span></p>
                            <p class="mb-2"><b>Nombre Rep. Suplente:</b> <span class="text-muted">@(EmpresaSeleccionada.NombreSuplente ?? "N/A")</span></p>
                            <p class="mb-2"><b>C.C Rep Suplente:</b> <span class="text-muted">@(EmpresaSeleccionada.IdentificacionS ?? "N/A")</span></p>
                            <p class="mb-2"><b>Revisor Fiscal:</b> <span class="text-muted">@(EmpresaSeleccionada.RevisorFiscal ?? "N/A")</span></p>
                            <p class="mb-2"><b>C.C Revisor Fiscal:</b> <span class="text-muted">@(EmpresaSeleccionada.IdentificacionRf ?? "N/A")</span></p>
                        </div>

                      
                    </div>

                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
}









    
@code {
    //captrar el nombre en la barra e busqueda y hacer la consulta a la base de datos
    public string NombreCompleto { get; set; } = default!;
    public List<EmpresaResponse> ListaEmpresas { get; set; } = new List<EmpresaResponse>();

    // ==========================================================
    // AGREGA ESTAS DOS LÍNEAS JUSTO AQUÍ:
    private bool MostrarModal { get; set; } = false;
    private EmpresaResponse? EmpresaSeleccionada { get; set; }
    // ==========================================================
    private void CerrarModal()
    {
        MostrarModal = false;
        EmpresaSeleccionada = null;
    }




    protected override async Task OnInitializedAsync()
    {
        //logica para cargar la lista de empresas
        var rpta = await EmpresaProxy.Listar();
        ListaEmpresas = rpta.Data;
    }

    private void editar(string EmpresaId)
    {

        navigationManager.NavigateTo($"/empresa/editar/{EmpresaId}");//logica para editar empresa por id
    }

    private async Task eliminar(string EmpresaId)
    {
        SweetAlertResult result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Desea eliminar la empresa " + EmpresaId + "?",
            Text = "¡No podrás recuperar los datos de esta empresa!",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "¡Sí, bórralo!",
            CancelButtonText = "No, consérvalo"
        });
        if (!string.IsNullOrEmpty(result.Value))
        {
            await Swal.FireAsync(
              "Eliminado",
              "La empresa ha sido eliminada:" + EmpresaId,
              SweetAlertIcon.Success
              );
        }

    }

    private async Task verDetalles(string EmpresaId)
    {
        //logica para ver detalles de contrato
        //Console.WriteLine($"Ver detalles del contrato con id: {EmpresaId}");


        EmpresaSeleccionada = ListaEmpresas.FirstOrDefault(e => e.EmpresaId == EmpresaId);

        if (EmpresaSeleccionada != null)
        {
            MostrarModal = true;
        }
        else
        {
            await Swal.FireAsync("Error", "No se encontró la información de la empresa.", SweetAlertIcon.Error);
        }

    }







   

    //pasa pagina para agregar empresa
    private void Nuevo()
    {
        navigationManager.NavigateTo("/empresa/add");
    }

    private void buscar()
    {
        //logica para buscar empresa por nombre completo
        Console.WriteLine($"nombre: {NombreCompleto}");
    }
    private void limpiar()
    {
        NombreCompleto = string.Empty;
    }






    //componentes para paginacion

    private int paginaActual = 1;
    private int tamañoPagina = 5;

    // LINQ se encarga de segmentar cualquier tipo de objeto

   
    private IEnumerable<EmpresaResponse> EmpresasPaginadas
    {
        get
        {
            // 1. Si el input está vacío, tomamos toda la lista original
            var contratosFiltrados = ListaEmpresas;

            // 2. Si el usuario escribió algo, filtramos en tiempo real por NIT (EmpresaId)
            if (!string.IsNullOrWhiteSpace(NombreCompleto))
            {
                contratosFiltrados = ListaEmpresas
                    .Where(c => c.EmpresaId != null &&
                                c.EmpresaId.Contains(NombreCompleto, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }

            // 3. Aplicamos la paginación sobre el resultado final (sea filtrado o no)
            return contratosFiltrados
                .Skip((paginaActual - 1) * tamañoPagina)
                .Take(tamañoPagina);
        }
    }

    
    

    // También debes ajustar el cálculo de TotalPaginas para que la paginación se adapte al filtro:
    private int TotalPaginas
    {
        get
        {
            if (string.IsNullOrWhiteSpace(NombreCompleto))
            {
                return (int)Math.Ceiling((double)ListaEmpresas.Count / tamañoPagina);
            }

            int conteoFiltrado = ListaEmpresas
                .Count(c => c.EmpresaId != null &&
                            c.EmpresaId.Contains(NombreCompleto, StringComparison.OrdinalIgnoreCase));

            return (int)Math.Ceiling((double)conteoFiltrado / tamañoPagina);
        }
    }




    // Método para saltar entre páginas
    private void CambiarPagina(int nuevaPagina)
    {
        paginaActual = nuevaPagina;
    }

   
}
