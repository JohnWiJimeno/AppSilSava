                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="sil-metric m-amber">
                            <div class="sil-metric-icon icon-amber">💰</div>
                            <div class="sil-metric-label">Valor total contratos</div>
                            <div class="sil-metric-val" style="color:var(--sil-amber);">
                                @stats.ValorTotalFormat
                            </div>
