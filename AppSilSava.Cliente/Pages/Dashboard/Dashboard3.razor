                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="sil-metric m-purple">
                            <div class="sil-metric-icon icon-purple">🏢</div>
                            <div class="sil-metric-label">Empresas registradas</div>
                            <div class="sil-metric-val" style="color:#b388ff;">
                                @stats.Empresas
                            </div>
                            <div class="sil-metric-trend trend-down">▼ −2 desactivadas</div>
                        </div>
                    </div>
                </div>

                @* ── FILA 2: TABLA + ESTADOS ── *@
                <div class="row g-3 mb-4">
                    <div class="col-xl-7">
                        <div class="sil-card h-100">
                            <div class="sil-card-header">
                                <div class="sil-card-title">
                                    <span class="dot dot-blue"></span>
                                    Licitaciones recientes
                                </div>
                                <button class="sil-btn-outline" style="font-size:.7rem;padding:.3rem .7rem;"
                                        @onclick='()=>Nav.NavigateTo("/licitaciones")'>
                                    Ver todas →
                                </button>
                            </div>
                            <div class="p-0">
                                <table class="sil-table">
                                    <thead>
                                        <tr>
                                            <th>No. proceso</th>
                                            <th>Objeto</th>
                                            <th>Tipo pliego</th>
                                            <th>Valor</th>
                                            <th>Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var l in licitaciones)
                                        {
                                            <tr>
                                                <td><span class="sil-code">@l.NoProceso</span></td>
                                                <td style="max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                                    @l.Objeto
                                                </td>
                                                <td style="color:var(--sil-muted);font-size:.72rem;">@l.TipoPliego</td>
                                                <td style="font-family:var(--font-mono);font-size:.73rem;">
                                                    @l.ValorProceso.ToString("C0")
                                                </td>
                                                <td>
                                                    <span class="sil-chip @ChipClass(l.Estado)">@l.Estado</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-5">
                        <div class="sil-card h-100">
                            <div class="sil-card-header">
                                <div class="sil-card-title">
                                    <span class="dot dot-amber"></span>
                                    Estado de contratos
                                </div>
                            </div>
                            <div class="sil-card-body">
                                <div class="sil-donut-wrap mb-3">
                                    <svg width="140" height="140" viewBox="0 0 140 140">
                                        @{ var donutData = GetDonutSegments(); }
                                        @foreach (var seg in donutData)
                                        {
                                            <circle cx="70" cy="70" r="52"
                                                    fill="none"
                                                    stroke="@seg.Color"
                                                    stroke-width="16"
                                                    stroke-dasharray="@seg.Dash @seg.Gap"
                                                    stroke-dashoffset="@seg.Offset"
                                                    stroke-linecap="round"
                                                    style="transition:stroke-dasharray .8s ease;" />
                                        }
                                    </svg>
                                    <div class="sil-donut-label">
                                        <span class="big">@TotalContratos</span>
                                        <span class="sm">total</span>
                                    </div>
                                </div>
                                @foreach (var e in estadosContrato)
                                {
                                    <div class="sil-legend-item">
                                        <div class="sil-legend-name">
                                            <div class="sil-legend-dot" style="background:@e.Color;"></div>
                                            @e.Estado
                                        </div>
                                        <div>
                                            <span class="sil-legend-count">@e.Cantidad</span>
                                            <span class="sil-legend-pct">@e.Porcentaje%</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @* ── FILA 3: INDICADORES + CAPACIDAD + ACTIVIDAD ── *@
                <div class="row g-3">
                    <div class="col-xl-5">
                        <div class="sil-card h-100">
                            <div class="sil-card-header">
                                <div class="sil-card-title">
                                    <span class="dot dot-green"></span>
                                    Indicadores financieros promedio
                                </div>
                                <button class="sil-btn-outline" style="font-size:.7rem;padding:.3rem .7rem;"
                                        @onclick='()=>Nav.NavigateTo("/analisis/financiero")'>
                                    Detalle →
                                </button>
                            </div>
                            <div class="sil-card-body">
                                <div class="sil-bar-row">
                                    <div class="sil-bar-label">Índice liquidez</div>
                                    <div class="sil-bar-track">
                                        <div class="sil-bar-fill" style="width:74%;background:var(--sil-accent);animation-delay:.1s"></div>
                                    </div>
                                    <div class="sil-bar-val">1.74</div>
                                </div>
                                <div class="sil-bar-row">
                                    <div class="sil-bar-label">Razón cobertura</div>
                                    <div class="sil-bar-track">
                                        <div class="sil-bar-fill" style="width:61%;background:#26c6da;animation-delay:.2s"></div>
                                    </div>
                                    <div class="sil-bar-val">3.2x</div>
                                </div>
                                <div class="sil-bar-row">
                                    <div class="sil-bar-label">Endeudamiento</div>
                                    <div class="sil-bar-track">
                                        <div class="sil-bar-fill" style="width:43%;background:var(--sil-amber);animation-delay:.3s"></div>
                                    </div>
                                    <div class="sil-bar-val">43%</div>
                                </div>
                                <div class="sil-bar-row">
                                    <div class="sil-bar-label">Renta activo</div>
                                    <div class="sil-bar-track">
                                        <div class="sil-bar-fill" style="width:18%;background:var(--sil-green);animation-delay:.4s"></div>
                                    </div>
                                    <div class="sil-bar-val">18%</div>
                                </div>
                                <div class="sil-bar-row">
                                    <div class="sil-bar-label">Renta patrimonio</div>
                                    <div class="sil-bar-track">
                                        <div class="sil-bar-fill" style="width:22%;background:var(--sil-green);animation-delay:.5s"></div>
                                    </div>
                                    <div class="sil-bar-val">22%</div>
                                </div>
                                <div class="sil-bar-row">
                                    <div class="sil-bar-label">Capital trabajo</div>
                                    <div class="sil-bar-track">
                                        <div class="sil-bar-fill" style="width:55%;background:#b388ff;animation-delay:.6s"></div>
                                    </div>
                                    <div class="sil-bar-val">$55M</div>
                                </div>
                                <p style="font-size:.65rem;color:var(--sil-muted);margin-top:.75rem;">
                                    Basado en @stats.LicitacionesActivas análisis del período actual
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3">
                        <div class="sil-card h-100">
                            <div class="sil-card-header">
                                <div class="sil-card-title">
                                    <span class="dot" style="background:#b388ff;box-shadow:0 0 6px #b388ff;animation:pulse 2s infinite;"></span>
                                    Capacidad técnica
                                </div>
                            </div>
                            <div class="sil-card-body">
                                <div class="sil-stat-row">
                                    <div class="sil-stat-label">👷 Profesionales activos</div>
                                    <span style="font-family:var(--font-mono);font-size:.82rem;font-weight:600;color:var(--sil-accent);">142</span>
                                </div>
                                <div class="sil-stat-row">
                                    <div class="sil-stat-label">🏢 Empresas habilitadas</div>
                                    <span style="font-family:var(--font-mono);font-size:.82rem;font-weight:600;">76</span>
                                </div>
                                <div class="sil-stat-row">
                                    <div class="sil-stat-label">🌱 MiPymes</div>
                                    <span class="sil-chip chip-adj">34 activas</span>
                                </div>
                                <div class="sil-stat-row">
                                    <div class="sil-stat-label">♿ Discapacitados</div>
                                    <span class="sil-chip chip-open">12</span>
                                </div>
                                <div class="sil-stat-row">
                                    <div class="sil-stat-label">👩‍💼 Emprend. mujer</div>
                                    <span class="sil-chip chip-open">9</span>
                                </div>
                                <div class="sil-stat-row">
                                    <div class="sil-stat-label">⏳ Análisis pend.</div>
                                    <span class="sil-chip chip-eval">7</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-4">
                        <div class="sil-card h-100">
                            <div class="sil-card-header">
                                <div class="sil-card-title">
                                    <span class="dot dot-blue"></span>
                                    Actividad reciente
                                </div>
                            </div>
                            <div class="sil-card-body">
                                @foreach (var a in actividades)
                                {
                                    <div class="sil-activity-item" style="animation-delay:@(actividades.IndexOf(a) * .07)s">
                                        <div class="sil-activity-dot" style="background:@a.Color;box-shadow:0 0 5px @a.Color;"></div>
                                        <div>
                                            <div class="sil-activity-text">@a.Texto</div>
                                            <div class="sil-activity-time">@a.Tiempo</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    bool cargando = true;
    DashboardStatsDto stats = new();
    List<LicitacionDto> licitaciones = new();
    List<EstadoContratoResumen> estadosContrato = new();
    int TotalContratos => estadosContrato.Sum(e => e.Cantidad);

    /* ── Actividad mock (reemplazar con datos reales) ── */
    List<ActividadItem> actividades = new()
    {
        new("Nueva licitación LIC-2024-048 creada", "Hace 5 min", "#00bcd4"),
        new("Contrato CON-156 adjudicado a Constructora XYZ", "Hace 18 min", "#00c853"),
        new("Empresa Ingeniería ABC actualiza documentos", "Hace 1h", "#90a4c8"),
        new("Análisis financiero aprobado — 3 empresas", "Hace 2h", "#7c4dff"),
        new("Usuario Juan Pérez inicia sesión", "Hace 3h", "#90a4c8"),
        new("Licitación LIC-2024-031 declarada desierta", "Hace 5h", "#ef5350"),
        new("MiPyme ID-882 habilitada técnicamente", "Hace 6h", "#ffab00"),
    };

    protected override async Task OnInitializedAsync() => await CargarTodo();

    async Task CargarTodo()
    {
        cargando = true;
        try
        {
            var t1 = Http.GetFromJsonAsync<DashboardStatsDto>("api/dashboard/stats");
            var t2 = Http.GetFromJsonAsync<List<LicitacionDto>>("api/dashboard/licitaciones?top=6");
            var t3 = Http.GetFromJsonAsync<List<EstadoContratoResumen>>("api/dashboard/contratos/estados");
            await Task.WhenAll(t1, t2, t3);
            stats          = t1.Result ?? new();
            licitaciones   = t2.Result ?? DatosDemo();
            estadosContrato = t3.Result ?? EstadosDemo();
        }
        catch
        {
            licitaciones    = DatosDemo();
            estadosContrato = EstadosDemo();
            stats = new() { LicitacionesActivas=47, ContratosEjecucion=23, ValorTotal=2_400_000_000, Empresas=184 };
        }
        finally { cargando = false; }
    }

    async Task RecargarDatos() => await CargarTodo();

    string ChipClass(string estado) => estado switch
    {
        "Adjudicada"    => "chip-adj",
        "En evaluación" => "chip-eval",
        "Abierta"       => "chip-open",
        "Desierta"      => "chip-des",
        "En ejecución"  => "chip-ejec",
        _               => "chip-open"
    };

    /* Donut SVG — genera segmentos */
    record DonutSeg(string Color, double Dash, double Gap, double Offset);
    List<DonutSeg> GetDonutSegments()
    {
        double circum = 2 * Math.PI * 52;
        double offset = 0;
        var segs = new List<DonutSeg>();
        foreach (var e in estadosContrato)
        {
            double frac = TotalContratos > 0 ? (double)e.Cantidad / TotalContratos : 0;
            double dash = frac * circum * .92;
            double gap  = circum - dash;
            segs.Add(new(e.Color, Math.Round(dash,1), Math.Round(gap,1), Math.Round(-offset,1)));
            offset += frac * circum;
        }
        return segs;
    }

    /* ── Datos de demostración (fallback sin API) ── */
    List<LicitacionDto> DatosDemo() => new()
    {
        new("LIC-2024-001","Construcción vía terciaria","Licitación pública",850_000_000,"Adjudicada"),
        new("LIC-2024-002","Suministro equipos TI","Selección abreviada",120_000_000,"En evaluación"),
        new("LIC-2024-003","Consultoría financiera","Concurso de méritos",45_000_000,"Abierta"),
        new("LIC-2024-004","Infraestructura de redes","Licitación pública",310_000_000,"En evaluación"),
        new("LIC-2024-005","Mantenimiento edificio","Mínima cuantía",18_000_000,"Desierta"),
        new("LIC-2024-006","Adquisición vehículos","Selección abreviada",95_000_000,"Adjudicada"),
    };

    List<EstadoContratoResumen> EstadosDemo() => new()
    {
        new("En ejecución", 23, 49, "#1976d2"),
        new("Terminados",   14, 30, "#00c853"),
        new("Suspendidos",   7, 15, "#ffab00"),
        new("Liquidados",    3,  6, "#7c4dff"),
    };

    /* ── DTOs locales ── */
    record DashboardStatsDto
    {
        public int     LicitacionesActivas { get; init; }
        public int     ContratosEjecucion  { get; init; }
        public decimal ValorTotal          { get; init; }
        public int     Empresas            { get; init; }
        public string  ValorTotalFormat    => ValorTotal >= 1_000_000_000
            ? $"${ValorTotal/1_000_000_000:F1}B"
            : $"${ValorTotal/1_000_000:F0}M";
    }
    record LicitacionDto(string NoProceso, string Objeto, string TipoPliego, decimal ValorProceso, string Estado);
    record EstadoContratoResumen(string Estado, int Cantidad, int Porcentaje, string Color);
    record ActividadItem(string Texto, string Tiempo, string Color);
}
