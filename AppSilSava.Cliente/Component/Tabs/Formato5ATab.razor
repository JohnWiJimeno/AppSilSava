<h5>Formato 5A</h5>
@inject HttpClient Http

@if (contratos == null)
{
    // PASO 1: La API aún no ha respondido. La lista es nula.
    <p><em>Cargando contratos y salarios del año actual...</em></p>
}
else if (!contratos.Any())
{
    // PASO 2: La API ya respondió con éxito, pero esa empresa NO tiene contratos.
    <p>No se encontraron contratos para esta empresa con salario registrado este año.</p>
}
else
{
    // PASO 3: La lista sí tiene datos (tiene 1 o más contratos). Pintamos la tabla.

    var total = contratos.Sum(c => c.VrTotalContrato ?? 0);
    var smmlvDisplay = contratos.FirstOrDefault()?.ValorSalarioActual?
        .ToString("$#,##0", CultureInfo.CreateSpecificCulture("es-CO")) ?? "";

    <div class="formato5a-container">
        <div class="formato5a-wrapper">
            <table>

                @* ── Anchos fijos proporcionales ── *@
                <colgroup>
                    <col class="col-w-num" />
                    <col class="col-w-smmlv" />
                    <col class="col-w-part" />
                    <col class="col-w-salario" />
                    <col class="col-w-total" />
                </colgroup>

                <thead>

                    @* ── Título ── *@
                    <tr>
                        <td colspan="5" class="formato5a-titulo">
                            Contratos para Acreditación de Experiencia
                        </td>
                    </tr>
                    <tr>
                        <td colspan="5" class="formato5a-subtitulo">
                            (Proponente o Integrante Nacional o Extranjero con Sucursal o Domicilio en Colombia)
                        </td>
                    </tr>

                    @* ── Nombre del proponente ── *@
                    <tr class="formato5a-proponente">
                        <td class="label-proponente">Nombre Proponente o Integrante:</td>
                        <td colspan="4" class="valor-proponente">@EmpresaId</td>
                    </tr>

                    @* ── Encabezados de columna ── *@
                    <tr class="fila-columnas">
                        <th>Contrato<br />No.</th>
                        <th class="col-shaded">
                            Contratos Relacionados con la Actividad de la
                            Construcción – Seg. 72 Clasif. UNSPSC del RUP (EN SMMLV)
                        </th>
                        <th class="col-shaded">
                            Participación Porcentual del Proponente o
                            Integrante del Oferente Plural
                        </th>
                        <th>
                            Valor del SMMLV<br />Vigente @DateTime.Now.Year<br />
                            <span style="font-weight:normal;">(@smmlvDisplay)</span>
                        </th>
                        <th>
                            Valor de los Contratos Ejecutados<br />
                            <span style="font-weight:normal; font-size:11px;">
                                (Valor del Contrato Ponderado por la Participación)
                            </span>
                        </th>
                    </tr>

                    @* ── Sub-etiquetas (A) / (B) / (C) / (A*B*C) ── *@
                    <tr class="fila-etiquetas">
                        <th></th>
                        <th class="col-shaded">(A)</th>
                        <th class="col-shaded">(B)</th>
                        <th>(C)</th>
                        <th>(A*B*C)</th>
                    </tr>

                </thead>

                <tbody>
                    @foreach (var contrato in contratos)
                    {
                        <tr>
                            <td class="col-num-data">@contrato.NoRup</td>
                            <td class="col-shaded">
                                @(contrato.VrSmmlv?.ToString("N2") ?? "0.00")
                            </td>
                            <td class="col-shaded">
                                @(contrato.PorcentajePart?.ToString("P2"))
                            </td>
                            <td>
                                @(contrato.ValorSalarioActual?.ToString(
                                    "#,##0.00", CultureInfo.CreateSpecificCulture("es-CO")))
                            </td>
                            <td>
                                @(contrato.VrTotalContrato?.ToString(
                                    "#,##0.00", CultureInfo.CreateSpecificCulture("es-CO")))
                            </td>
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <td colspan="4" class="label-total">TOTAL</td>
                        <td class="valor-total">
                            @total.ToString("#,##0.00", CultureInfo.CreateSpecificCulture("es-CO"))
                        </td>
                    </tr>
                </tfoot>

            </table>

            <div class="formato5a-nota">
                (Diligenciar únicamente las columnas sombreadas, toda vez que la columna F se encuentra Formulada)
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string? EmpresaId { get; set; }

    // Corregido: Nombre cambiado a 'contratos' y se inicializa en null para que funcione el condicional @if (contratos == null)
    private List<ContratoResponse>? contratos;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            // 1. Apuntamos al endpoint correcto de tu controlador
            var url = $"api/Contrato/por-empresa/{EmpresaId}";

            // 2. Mapeamos la respuesta al objeto genérico que usas en el backend
            var respuesta = await Http.GetFromJsonAsync<RepuestaBase<List<ContratoResponse>>>(url);

            if (respuesta != null && respuesta.Exito)
            {
                // 3. Asignamos la lista que viene dentro de 'Data'
                contratos = respuesta.Data;
            }
            else
            {
                contratos = new List<ContratoResponse>(); // Si falla, inicializa vacío para quitar el "Cargando..."
                Console.WriteLine($"Error del servidor: {respuesta?.Mensaje}");
            }
        }
        catch (Exception ex)
        {
            contratos = new List<ContratoResponse>(); // Si hay error de red, inicializa vacío
            Console.WriteLine($"Error de red: {ex.Message}");
        }
    }
}