<div class="container-fluid p-0">
    <div class="card mb-3 w-100">
        <div class="card-header bg-dark text-white fw-bold ">
                      
            @Titulo</div>
        <div class="card-body p-3 ">
            @Content
        </div>
    </div>
</div>

@code {
//para mostar los titulos usando un solo codigo que sea dinamico
    [EditorRequired]
    [Parameter]
    public string Titulo { get; set; } = string.Empty;
    //agrega la barra de busqueda  
    [Parameter]
    public RenderFragment Content { get; set; } = default!;

    [Parameter] 
    public bool EsAncho { get; set; } = false; // Por defecto será normal

    // 1. NUEVO PARAMETRO PARA EL ICONO
    [Parameter]
    public string Icono { get; set; } = string.Empty;
}

